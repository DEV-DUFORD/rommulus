<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <!-- Only INTERNET and ACCESS_NETWORK_STATE — no mic, storage, etc. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- TV feature declarations -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".RommApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/ic_tv_banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.RommAndroidTV">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Runs native Libretro emulation in its own process, isolated from the
          WebView-hosting main process (LIBRETRO_REFACTOR.md section 6). Not
          exported: reachable only from within this app, currently only via a
          debug-only diagnostics entry point in MainActivity. singleTask
          ensures a repeated launch intent routes to the existing instance
          rather than creating a second one; onNewIntent() in EmulationActivity
          rejects it as "player busy" instead of replacing a live session.
        -->
        <activity
            android:name=".emulation.process.EmulationActivity"
            android:process=":emulation"
            android:exported="false"
            android:launchMode="singleTask"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape" />

        <!--
          Remove WorkManager's default InitializationProvider because RommApplication
          implements Configuration.Provider for on-demand (lazy) initialization with a
          custom WorkerFactory. Without this, the provider auto-initializes WorkManager
          at process startup before our Application code runs, bypassing our factory.
          https://developer.android.com/topic/libraries/architecture/workmanager/advanced/custom-task#custom-configuration
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
