; ---------------------------------------------------------------------------
; mednafen_wswan-windows.def — PE export table for the Windows x86_64
; CANDIDATE build of the vendored Beetle WonderSwan core
; (mednafen_wswan-windows.cmake).
;
; Enumerates EXACTLY the Libretro exports the player's CoreLibrary resolves
; as required (native/engine/src/core_library.cpp load()): the 22 standard
; retro_* symbols, nothing else. The approved RomMulus save extensions
; (romm_get_save_memory_data / romm_get_save_memory_size /
; romm_apply_save_memory / romm_restore_save_memory) are OPTIONAL for a core;
; mednafen_wswan's libretro.c defines NONE of them at pin 4b01295 — the
; player's checkpoint/restore path uses the standard RETRO_MEMORY_SAVE_RAM
; region (retro_get_memory_data / retro_get_memory_size, both listed below),
; so none are listed here. Internal core symbols (and the unused upstream
; extras retro_cheat_reset / retro_cheat_set / retro_load_game_special) stay
; local to the DLL — the Windows CI export audit asserts this exact set via
; objdump.
;
; The definitions in libretro.c are C-linkage (libretro.h wraps its API in
; extern "C"), so the names below are undecorated, exactly as exported.
; ---------------------------------------------------------------------------
LIBRARY mednafen_wswan_core
EXPORTS
    retro_api_version
    retro_deinit
    retro_get_memory_data
    retro_get_memory_size
    retro_get_region
    retro_get_system_av_info
    retro_get_system_info
    retro_init
    retro_load_game
    retro_reset
    retro_run
    retro_serialize
    retro_serialize_size
    retro_set_audio_sample
    retro_set_audio_sample_batch
    retro_set_controller_port_device
    retro_set_environment
    retro_set_input_poll
    retro_set_input_state
    retro_set_video_refresh
    retro_unload_game
    retro_unserialize
