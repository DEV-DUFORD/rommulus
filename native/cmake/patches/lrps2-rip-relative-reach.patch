diff --git a/pcsx2/Memory.cpp b/pcsx2/Memory.cpp
index 1d5eba2be..60a97a980 100644
--- a/pcsx2/Memory.cpp
+++ b/pcsx2/Memory.cpp
@@ -79,6 +79,33 @@ static VirtualMemoryManagerPtr AllocateVirtualMemory(const char* name, size_t si
 		if (mgr->IsOk())
 			return mgr;
 	}
+#endif
+#if defined(__x86_64__) && !defined(_WIN32)
+	// The code arena is the one whose placement matters: the x86 recompilers
+	// emit signed 32-bit RIP-relative operands to module globals, so the arena
+	// must sit within +-2GB of this module's data. ASLR places the module and
+	// an mmap'd arena independently, so an OS-chosen base lands out of reach on
+	// some first launches. Walk page-aligned address hints near this module's
+	// own data, retrying until a reservation whose entire span is reachable
+	// succeeds. If none does, fall back to an OS-chosen base and let the
+	// hardened CheckRipRelativeReach abort rather than corrupt memory.
+	if (!name)
+	{
+		static u8 anchor;            // module data anchor, same .so as module globals
+		const uptr mod  = (uptr)&anchor;
+		const uptr step = 1 << 21;   // 2MB candidate granularity, page-aligned
+		for (int i = 0; i < 768; i++) // walk outward to ~1.5GB; 305MB arena keeps span < 2GB
+		{
+			const uptr delta = ((uptr)((i + 1) / 2)) * step;
+			uptr base = (i & 1) ? mod - delta : mod + delta;
+			base &= ~(uptr)(__pagesize - 1);
+			if ((sptr)base < 0 || (sptr)(base + size - 1) < 0)
+				continue;
+			VirtualMemoryManagerPtr mgr = std::make_shared<VirtualMemoryManager>(name, base, size, /*upper_bounds=*/0, /*strict=*/true);
+			if (mgr->IsOk())
+				return mgr;
+		}
+	}
 #endif
 	return std::make_shared<VirtualMemoryManager>(name, 0, size);
 }
