+static ExpansionInterface::CEXIMemoryCard* get_slot_a_memory_card()
+{
+  // Force hardware boot before touching EXI: see EnsureEmuThreadLaunched().
+  Libretro::EnsureEmuThreadLaunched();
+  auto* device = Core::System::GetInstance().GetExpansionInterface().GetDevice(
+      ExpansionInterface::Slot::A);
+  return dynamic_cast<ExpansionInterface::CEXIMemoryCard*>(device);
+}
+
+RETRO_API size_t romm_get_save_memory_size()
+{
+  auto* card = get_slot_a_memory_card();
+  return card ? card->GetSaveMemorySize() : 0;
+}
+
+RETRO_API void* romm_get_save_memory_data()
+{
+  static std::vector<u8> snapshot;
+  auto* card = get_slot_a_memory_card();
+  if (!card)
+    return nullptr;
+
+  const size_t size = card->GetSaveMemorySize();
+  if (size == 0)
+    return nullptr;
+  snapshot.resize(size);
+  if (!card->CopySaveMemory(snapshot.data(), snapshot.size()))
+  {
+    snapshot.clear();
+    return nullptr;
+  }
+  return snapshot.data();
+}
+
+RETRO_API bool romm_restore_save_memory(const void* data, size_t size)
+{
+  auto* card = get_slot_a_memory_card();
+  return card && data && card->RestoreSaveMemory(static_cast<const u8*>(data), size);
+}
