+size_t CEXIMemoryCard::GetSaveMemorySize()
+{
+  if (!m_memory_card)
+    return 0;
+  return static_cast<size_t>(m_memory_card->GetCardId()) * 1024 * 8 * 16;
+}
+
+bool CEXIMemoryCard::CopySaveMemory(u8* destination, size_t size)
+{
+  if (!destination || size != GetSaveMemorySize())
+    return false;
+  for (size_t offset = 0; offset < size; offset += Memcard::BLOCK_SIZE)
+  {
+    std::memset(destination + offset, 0xFF, Memcard::BLOCK_SIZE);
+    const s32 read = m_memory_card->Read(static_cast<u32>(offset), Memcard::BLOCK_SIZE,
+                                         destination + offset);
+    if (read != 0 && read != Memcard::BLOCK_SIZE)
+      return false;
+  }
+  return true;
+}
+
+bool CEXIMemoryCard::RestoreSaveMemory(const u8* source, size_t size)
+{
+  if (!source || size != GetSaveMemorySize())
+    return false;
+  const auto write_block = [&](u32 block) {
+    const size_t offset = static_cast<size_t>(block) * Memcard::BLOCK_SIZE;
+    return m_memory_card->Write(offset, Memcard::BLOCK_SIZE, source + offset) ==
+           Memcard::BLOCK_SIZE;
+  };
+
+  // GCI-folder cards validate directory entries against the BAT as soon as
+  // a directory block lands. Restore both BAT copies before either directory.
+  for (const u32 block : std::array<u32, 5>{3, 4, 0, 1, 2})
+    if (!write_block(block))
+      return false;
+
+  const u32 block_count = static_cast<u32>(size / Memcard::BLOCK_SIZE);
+  for (u32 block = 5; block < block_count; ++block)
+    if (!write_block(block))
+      return false;
+  return true;
+}
+
 bool CEXIMemoryCard::UseDelayedTransferCompletion() const
 {
   return true;
