@@ -280,6 +280,10 @@ void MTGS::MainLoop(bool flush_all)
 				case GS_RINGTYPE_INIT_AND_READ_FIFO:
 					GSInitAndReadFIFO((u8*)tag.pointer, tag.data[0]);
 					break;
+				case GS_RINGTYPE_SWITCH_RENDERER:
+					GSSwitchRenderer(static_cast<GSRendererType>(tag.data[0]), hw_render.context_type,
+						static_cast<GSInterlaceMode>(tag.data[1]));
+					break;
 				// Optimized performance in non-Dev builds.
