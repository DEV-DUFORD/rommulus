+/* RomMulus save-memory extensions (PS2 memory card image). The frontend
+ * resolves these by symbol name (see core_library.cpp) and drives them through
+ * the generic checkpoint / restore-on-launch flow. They read and write the
+ * whole in-RAM card image for slot 0 (Mcd001.ps2) without the PS2 flash
+ * AND-merge semantics of FileMcd_Save, so a previously captured image restores
+ * verbatim. FileMcd_EmuOpen() is idempotent (guarded by FileMcd_Open) and
+ * ensures the card is loaded even if the frontend calls in before the VM has
+ * fully booted (restore-on-launch happens right after retro_load_game()). */
+extern "C" {
+
+RETRO_API size_t romm_get_save_memory_size(void)
+{
+	FileMcd_EmuOpen();
+	return FileMcd_GetRawSize(0, 0);
+}
+
+RETRO_API void* romm_get_save_memory_data(void)
+{
+	static std::vector<u8> snapshot;
+	const size_t size = romm_get_save_memory_size();
+	if (size == 0)
+		return nullptr;
+	snapshot.resize(size);
+	if (FileMcd_ReadRaw(0, 0, snapshot.data(), size) != static_cast<s32>(size))
+	{
+		snapshot.clear();
+		return nullptr;
+	}
+	return snapshot.data();
+}
+
+RETRO_API bool romm_restore_save_memory(const void* data, size_t size)
+{
+	return data &&
+		FileMcd_SaveRaw(0, 0, static_cast<const u8*>(data), size) == static_cast<s32>(size);
+}
+
+}  // extern "C"
