+size_t FileMcd_GetRawSize(uint port, uint slot)
+{
+	const uint combinedSlot = FileMcd_ConvertToSlot(port, slot);
+	if (EmuConfig.Mcd[combinedSlot].Type == MemoryCardType::File)
+		return Mcd::impl.GetRawSize(combinedSlot);
+	return 0;
+}
+
+s32 FileMcd_ReadRaw(uint port, uint slot, u8* dest, size_t size)
+{
+	const uint combinedSlot = FileMcd_ConvertToSlot(port, slot);
+	if (EmuConfig.Mcd[combinedSlot].Type == MemoryCardType::File &&
+		Mcd::impl.CopyRaw(dest, size, combinedSlot))
+		return static_cast<s32>(size);
+	return 0;
+}
+
+s32 FileMcd_SaveRaw(uint port, uint slot, const u8* src, size_t size)
+{
+	const uint combinedSlot = FileMcd_ConvertToSlot(port, slot);
+	if (EmuConfig.Mcd[combinedSlot].Type == MemoryCardType::File &&
+		Mcd::impl.RestoreRaw(src, size, combinedSlot))
+		return static_cast<s32>(size);
+	return 0;
+}
