+size_t FileMemoryCard::GetRawSize(uint slot)
+{
+	if (!m_cardData[slot])
+		return 0;
+	return m_cardSize[slot];
+}
+
+bool FileMemoryCard::CopyRaw(u8* dest, size_t size, uint slot)
+{
+	if (!dest || size != m_cardSize[slot] || !m_cardData[slot])
+		return false;
+	memcpy(dest, m_cardData[slot], size);
+	return true;
+}
+
+bool FileMemoryCard::RestoreRaw(const u8* src, size_t size, uint slot)
+{
+	if (!src || size != m_cardSize[slot] || !m_cardData[slot])
+		return false;
+	memcpy(m_cardData[slot], src, size);
+
+	/* Recompute the checksum word from the restored bytes (it lives at
+	 * m_chkaddr) so the restored card passes PCSX2's integrity check on the
+	 * next read, then persist the whole image so the card survives Close. */
+	if (!m_ispsx[slot])
+	{
+		m_chksum[slot] = 0;
+		for (size_t i = 0; i < size; i += 8)
+		{
+			u64 w = 0;
+			const size_t n = (size - i < 8) ? (size - i) : 8;
+			memcpy(&w, m_cardData[slot] + i, n);
+			m_chksum[slot] ^= w;
+		}
+		memcpy(m_cardData[slot] + m_chkaddr, &m_chksum[slot], sizeof(m_chksum[slot]));
+	}
+
+	if (!Seek(m_file[slot], 0))
+		return false;
+	return rfwrite(m_cardData[slot], m_cardSize[slot], 1, m_file[slot]) == 1;
+}
