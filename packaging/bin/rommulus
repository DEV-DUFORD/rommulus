#!/usr/bin/env bash
# ============================================================================
# RomMulus — Linux x86_64 launcher (bin/rommulus)
#
# plans/LINUX_X64.md §16.1 "Initial artifact" — launcher contract:
#   * resolves installation paths relative to itself (symlink-safe);
#   * sets only the necessary JVM/native library paths;
#   * does NOT put credentials in environment variables — RomM server tokens
#     live in the freedesktop Secret Service and are read from there by the
#     desktop app (plans/LINUX_X64.md §10). This script sets no ROMM*/
#     ROMMULUS* credential variables, ever;
#   * uses exec to replace itself with the desktop app;
#   * preserves the user XDG environment: XDG_* variables are READ (with
#     spec defaults when unset) but never modified or exported;
#   * fails explicitly if bundled files are missing or modified unexpectedly
#     (see exit codes below).
#
# Bundle layout (relative to APP_ROOT, the parent of this script's directory):
#   bin/rommulus                 this launcher
#   bin/rommulus-player          the native player (ELF x86_64)
#   bin/rommulus_player          compatibility symlink -> rommulus-player; the
#                                desktop app resolves "rommulus_player" via PATH
#   lib/runtime/                 jlink JVM runtime (bin/java, lib/, conf/)
#   lib/rommulus/app.jar         Compose Multiplatform desktop application
#   lib/rommulus/*.so            player runtime shared libraries (if any)
#   lib/rommulus/cores/          bundled Libretro cores (lib<core>_core.so)
#   share/rommulus/core-manifest.json
#   share/rommulus/PACKAGE.sha256  release checksum manifest
#   share/applications/, share/icons/, share/licenses/rommulus/
#
# Usage:
#   rommulus [--verify-full] [args passed through to the desktop app]
#     --verify-full   verify EVERY file in PACKAGE.sha256 (slow); the default
#                     verifies only the security-critical set (player, cores,
#                     app jar, core-manifest.json, bundled JVM runtime natives).
#
# Environment:
#   ROMMULUS_NO_CORE_SEED=1  disable installation/update of bundled cores in
#                            $XDG_DATA_HOME/rommulus/cores.
#
# Exit codes:
#   0  success
#   3  required bundle file missing (incomplete or corrupted extraction)
#   4  checksum mismatch / manifest problem (bundle modified unexpectedly)
#   5  no usable JVM found (bundled runtime and all fallbacks failed)
# ============================================================================
set -euo pipefail

PROG="rommulus"

die() { # die <exit-code> <message...>
  printf '%s: error: %s\n' "$PROG" "$*" >&2
  exit "$1"
}
warn() {
  printf '%s: warning: %s\n' "$PROG" "$*" >&2
}

# ---------------------------------------------------------------------------
# 1. Resolve installation paths relative to this script (symlink-safe).
#    readlink -f resolves intermediate and final symlinks; pwd -P normalizes.
# ---------------------------------------------------------------------------
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")" \
  || die 3 "cannot resolve the absolute path of this launcher"
BIN_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)" \
  || die 3 "cannot resolve the bin/ directory containing this launcher"
APP_ROOT="$(cd -- "$BIN_DIR/.." && pwd -P)" \
  || die 3 "cannot resolve the installation root (parent of bin/)"

[ -d "$APP_ROOT/lib" ] \
  || die 3 "not a RomMulus installation: $APP_ROOT/lib is missing (launcher resolved to $SCRIPT_PATH); re-extract the tarball"

# ---------------------------------------------------------------------------
# 2. Fail explicitly if required bundled files are missing.
# ---------------------------------------------------------------------------
REQUIRED_FILES=(
  "bin/rommulus-player"
  "bin/rommulus-player-deck"
  "lib/rommulus/app.jar"
  "share/rommulus/core-manifest.json"
  "share/rommulus/PACKAGE.sha256"
)
for rel in "${REQUIRED_FILES[@]}"; do
  [ -f "$APP_ROOT/$rel" ] \
    || die 3 "required bundle file is missing: $APP_ROOT/$rel — the installation is incomplete; re-extract a pristine tarball"
done

runtime_jar_count=0
for f in "$APP_ROOT"/lib/rommulus/lib/*.jar; do
  [ -f "$f" ] && runtime_jar_count=$((runtime_jar_count + 1))
done
[ "$runtime_jar_count" -gt 0 ] \
  || die 3 "desktop runtime libraries are missing under $APP_ROOT/lib/rommulus/lib/ — the installation is incomplete; re-extract a pristine bundle"

core_count=0
for f in "$APP_ROOT"/lib/rommulus/cores/lib*.so; do
  [ -f "$f" ] && core_count=$((core_count + 1))
done
[ "$core_count" -gt 0 ] \
  || die 3 "no bundled cores found under $APP_ROOT/lib/rommulus/cores/ — the installation is incomplete; re-extract a pristine tarball"

# ---------------------------------------------------------------------------
# 3. Fail explicitly if bundled files were modified unexpectedly.
#    PACKAGE.sha256 (generated by packaging/build-tarball.sh) lists
#    "<sha256>  <relative-path>" for every shipped file except itself.
#    Default: verify the security-critical set (tampered player/cores/app
#    jar/JVM runtime = arbitrary code execution). --verify-full: every file.
# ---------------------------------------------------------------------------
MANIFEST="$APP_ROOT/share/rommulus/PACKAGE.sha256"
RUNTIME_DIR="$APP_ROOT/lib/runtime"

expected_hash() { # expected_hash <relpath> -> prints the recorded hash, or nothing
  awk -v p="$1" '$2 == p { print $1; exit }' "$MANIFEST"
}

verify_rel() { # verify_rel <relpath>
  local rel="$1" actual expected
  expected="$(expected_hash "$rel")"
  [ -n "$expected" ] \
    || die 4 "bundle manifest has no checksum for $rel — unexpected modification of the package layout"
  actual="$(sha256sum -- "$APP_ROOT/$rel" | cut -d' ' -f1)"
  [ "$actual" = "$expected" ] \
    || die 4 "checksum mismatch for $rel (expected $expected, got $actual) — bundled file modified after packaging; re-extract a pristine tarball"
}

CRITICAL=(
  "bin/rommulus-player"
  "bin/rommulus-player-deck"
  "lib/rommulus/app.jar"
  "share/rommulus/core-manifest.json"
)
for f in "$APP_ROOT"/lib/rommulus/lib/*.jar \
  "$APP_ROOT"/lib/rommulus/*.so \
  "$APP_ROOT"/lib/rommulus/cores/lib*.so; do
  [ -f "$f" ] || continue
  CRITICAL+=("${f#"$APP_ROOT"/}")
done

# The bundled JVM runtime is code-execution-critical too: a tampered java
# binary or runtime .so would execute attacker code under the app's identity.
# Its native files join the default (still fast) verify set. Only files that
# exist are checked — an incomplete bundle falling back to an external JVM
# (section 4) has no bundled runtime files to verify.
if [ -f "$RUNTIME_DIR/bin/java" ]; then
  CRITICAL+=("lib/runtime/bin/java")
fi
for f in "$RUNTIME_DIR"/lib/*.so; do
  [ -f "$f" ] || continue
  CRITICAL+=("${f#"$APP_ROOT"/}")
done

if [ "${1:-}" = "--verify-full" ]; then
  while read -r _hash rel; do
    [ -n "$rel" ] || continue
    verify_rel "$rel"
  done < "$MANIFEST"
else
  for rel in "${CRITICAL[@]}"; do
    verify_rel "$rel"
  done
fi

# ---------------------------------------------------------------------------
# 4. Locate the JVM: bundled jlink runtime first, then documented fallbacks.
#    Primary:  $APP_ROOT/lib/runtime/bin/java   (the shipped jlink image)
#    Fallback: $JAVA_HOME/bin/java              (if set and valid)
#    Fallback: `java` on PATH                   (last resort)
#    Any fallback means the bundle is incomplete — warn, but do not fail.
#    (RUNTIME_DIR was defined in section 3.)
# ---------------------------------------------------------------------------
if [ -x "$RUNTIME_DIR/bin/java" ]; then
  JAVA_BIN="$RUNTIME_DIR/bin/java"
  export JAVA_HOME="$RUNTIME_DIR"
elif [ -n "${JAVA_HOME:-}" ] && [ -x "${JAVA_HOME}/bin/java" ]; then
  warn "bundled JVM runtime is missing ($RUNTIME_DIR/bin/java) — falling back to JAVA_HOME=$JAVA_HOME (incomplete bundle)"
  JAVA_BIN="$JAVA_HOME/bin/java"
else
  if command -v java >/dev/null 2>&1; then
    warn "bundled JVM runtime is missing ($RUNTIME_DIR/bin/java) and JAVA_HOME is unset or invalid — falling back to system 'java' on PATH (incomplete bundle)"
    JAVA_BIN="$(command -v java)"
  else
    die 5 "no usable JVM: $RUNTIME_DIR/bin/java is missing, JAVA_HOME is unset or invalid, and no 'java' was found on PATH"
  fi
fi

# ---------------------------------------------------------------------------
# 5. Install bundled cores into the user's XDG data directory.
#    The desktop app derives ROMM_PLAYER_ALLOWED_CORES by scanning
#    $XDG_DATA_HOME/rommulus/cores for lib*.so at launch time; without the
#    bundled cores installed there, no core would be available. A packaged
#    core replaces an older packaged copy with the same canonical filename.
#    Saves and custom cores with other filenames remain untouched.
#    XDG_DATA_HOME is read with the spec default; it is never modified.
# ---------------------------------------------------------------------------
if [ "${ROMMULUS_NO_CORE_SEED:-0}" != "1" ]; then
  XDG_DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
  CORES_DEST="$XDG_DATA/rommulus/cores"
  mkdir -p -- "$CORES_DEST" || die 3 "cannot create core directory $CORES_DEST"
  for src in "$APP_ROOT"/lib/rommulus/cores/lib*.so; do
    [ -f "$src" ] || continue
    dest="$CORES_DEST/$(basename -- "$src")"
    if [ ! -e "$dest" ]; then
      cp -p -- "$src" "$dest" \
        || die 3 "failed to install bundled core $(basename -- "$src") into $CORES_DEST"
      printf '%s: installed bundled core %s -> %s\n' "$PROG" "$(basename -- "$src")" "$CORES_DEST" >&2
    elif [ -L "$dest" ] || [ ! -f "$dest" ]; then
      die 3 "cannot update bundled core at non-regular path: $dest"
    elif ! cmp -s -- "$src" "$dest"; then
      tmp="$CORES_DEST/.$(basename -- "$src").tmp.$$"
      cp -p -- "$src" "$tmp" \
        || die 3 "failed to stage bundled core update for $(basename -- "$src")"
      mv -f -- "$tmp" "$dest" \
        || die 3 "failed to activate bundled core update for $(basename -- "$src")"
      printf '%s: updated bundled core %s -> %s\n' "$PROG" "$(basename -- "$src")" "$CORES_DEST" >&2
    fi
  done
fi

# ---------------------------------------------------------------------------
# 6. Set only the necessary JVM/native library paths, then exec.
#    - LD_LIBRARY_PATH: player runtime libs + cores dir (prepended; any user
#      value is preserved after it).
#    - PATH: $APP_ROOT/bin prepended so the desktop app can resolve the
#      player binary ("rommulus_player" compatibility symlink) via PATH.
#    - No credential variables are set (Secret Service only, §10).
# ---------------------------------------------------------------------------
LIB_DIRS="$APP_ROOT/lib/rommulus:$APP_ROOT/lib/rommulus/cores"
if [ -n "${LD_LIBRARY_PATH:-}" ]; then
  export LD_LIBRARY_PATH="$LIB_DIRS:${LD_LIBRARY_PATH}"
else
  export LD_LIBRARY_PATH="$LIB_DIRS"
fi
export PATH="$APP_ROOT/bin${PATH:+:$PATH}"

# All supported Linux compositors use the offscreen presenter. The isolated
# direct-framebuffer player remains available only through an explicit
# ROMM_FORCE_STEAM_DECK_PLAYER=1 diagnostic override.

ARGS=("$@")
if [ "${1:-}" = "--verify-full" ]; then
  ARGS=("${@:2}")
fi

APP_CLASSPATH="$APP_ROOT/lib/rommulus/app.jar:$APP_ROOT/lib/rommulus/lib/*"
exec "$JAVA_BIN" -cp "$APP_CLASSPATH" com.romm.desktop.MainKt ${ARGS+"${ARGS[@]}"}
